# Telegram Bot (optional, for push alerts)
# 1) BotFather → /newbot → Token hier eintragen
# 2) Bot anschreiben, dann chat id z.B. via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
#
# Für Cloud ohne PC dieselben Werte als GitHub Actions Secrets setzen:
# Settings → Secrets and variables → Actions
#   TELEGRAM_BOT_TOKEN
#   TELEGRAM_CHAT_ID


# Optional: Nakordoni Border Queue API (HR↔BA Wartezeiten)
# https://nakordoni.eu/en/developers/docs/border
# Auch als GitHub Secret NAKORDONI_API_KEY setzen
NAKORDONI_API_KEY=

# Optional: Live-Routing mit Verkehr (eins reicht)
# Google Cloud → Maps Routes API / Directions API Key
GOOGLE_MAPS_API_KEY=
# oder TomTom Developer Key
TOMTOM_API_KEY=

# Optional: HAK-Grenzkameras per KI auswerten (OpenAI Vision)
# Key von https://platform.openai.com/api-keys
# Auch als GitHub Secret OPENAI_API_KEY setzen. Ohne Key werden die Kameras
# nur im Dashboard eingebettet (keine KI-Auswertung).
OPENAI_API_KEY=
# Optional Vision-Modell-Override (Default in Config: gpt-4o)
# OPENAI_VISION_MODEL=gpt-4o

# Optional override for Slovenian traffic JSON
# PROMET_JSON_URL=https://www.promet.si/dc/b2b.dogodki.json?language=en_US

# Optional config path
# TRAFFIC_CONFIG=traffic_monitor/config/watchpoints.yaml
